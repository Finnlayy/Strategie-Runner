# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KRAKEN_API_KEY: Kraken Account API Key for live and paper validation routing.
KRAKEN_API_KEY=""

# KRAKEN_API_SECRET: Kraken Account API Secret (HMAC-SHA512 private key).
KRAKEN_API_SECRET=""

# KRAKEN_PAPER_TRADING: "true" for Kraken exchange order validation without capital risk (validate=true), or "false" for live order execution.
KRAKEN_PAPER_TRADING="true"

# OHLCV_LAKE_DIR: Local directory path for partitioned Parquet storage
OHLCV_LAKE_DIR="data/lake/ohlcv"

# GDRIVE_SERVICE_ACCOUNT_FILE: Path to Google Service Account JSON credentials
GDRIVE_SERVICE_ACCOUNT_FILE="secrets/service_account.json"

# GDRIVE_REMOTE_BASE_PATH: Remote Google Drive path for cloud sync
GDRIVE_REMOTE_BASE_PATH="Backtest_Data/OHLCV"


# ===========================================================================
# GROK (xAI) ENGINE — LLM-Orchestrierungsschicht (server/grokEngine.ts)
# ===========================================================================
# XAI_API_KEY: xAI-API-Key. Ohne diesen Schlüssel bleiben alle KI-Endpunkte
# auf Gemini bzw. dem lokalen Fallback-Heuristikpfad (kein Ausfall der App).
XAI_API_KEY=""

# XAI_BASE_URL: Basis-URL der xAI API (Responses API wird genutzt).
XAI_BASE_URL="https://api.x.ai/v1"

# QUANT_LLM_PROVIDER: grok | gemini | hybrid | off
#   hybrid  = Grok primär, Gemini als Fallback (Default, sobald XAI_API_KEY gesetzt)
#   grok    = Grok hart erzwungen (kein Gemini-Rückfall)
#   gemini  = Grok-Schicht deaktiviert
QUANT_LLM_PROVIDER="hybrid"

# XAI_TIER: Rate-Limit-Tier hart setzen (0-4). Leer = automatisch aus dem
# kumulierten Spend abgeleitet (Tier 0 ab $0, T1 $50, T2 $250, T3 $1000, T4 $5000).
XAI_TIER=""

# GROK_MONTHLY_SPEND_CAP_USD: Hartes Monatsbudget. Darüber verweigert die Engine
# neue LLM-Aufrufe (HTTP 429) und setzt den Spend-Breaker.
GROK_MONTHLY_SPEND_CAP_USD="250"

# GROK_DEGRADE_AT_BUDGET_PCT: ab diesem Budgetverbrauch % fallen unkritische
# Taskklassen auf die Economy-Modellkette zurück (kein Downgrade latenzkritischer Pfade).
GROK_DEGRADE_AT_BUDGET_PCT="80"

# Positionsgrenzen der Output-Guardrails (harte Clamps, bevor ein Signal den
# Broker/Executor erreicht).
GROK_MAX_ALLOCATION_PCT="0.25"
GROK_MAX_RISK_PER_TRADE_PCT="0.02"

# GROK_MAX_TOOL_TURNS: harte Kante für serverseitige Tool-Schleifen
# (x_search / code_interpreter), Analogon zu Pydantic AI `xai_max_turns`.
GROK_MAX_TOOL_TURNS="5"

# GROK_MAX_REPAIR_ATTEMPTS: Validierungs-Repair-Loop, bevor abgebrochen wird.
GROK_MAX_REPAIR_ATTEMPTS="2"

# GROK_PROMPT_TOKEN_BUDGET: Long-Context-Clamp. xAI berechnet Requests ab 200k
# Prompt-Token für ALLE Token zum doppelten Preis — dieser Wert verhindert das.
GROK_PROMPT_TOKEN_BUDGET="180000"

# GROK_REQUEST_TIMEOUT_MS / Latenschutz pro Modellaufruf.
GROK_REQUEST_TIMEOUT_MS="90000"

# Tool-Kostenschätzung (USD pro 1000 Aufrufe) für Budgetvorbehalt und Ledger.
GROK_XSEARCH_COST_PER_1K_USD="5.00"
GROK_CODE_EXEC_COST_PER_1K_USD="5.00"

# Serverseitige Tools global erlauben (Kostenhebel!). x_search liefert X-Posts,
# code_interpreter berechnet Indikatoren deterministisch in der xAI-Sandbox.
GROK_ENABLE_XSEARCH="true"
GROK_ENABLE_CODE_EXEC="false"

# GROK_ANONYMIZE_BACKTEST_PROMPTS: auto | always | never
#   auto   = anonymisiert Entitäten, sobald das Backtestfenster im
#            Trainingszeitraum des Modells liegt (Schutz gegen parametrischen
#            Look-Ahead Bias und den Distraction Effect)
GROK_ANONYMIZE_BACKTEST_PROMPTS="auto"

# GROK_LEDGER_FILE: Speicherort der Kostenbuchung (JSONL, wird rotiert).
GROK_LEDGER_FILE="data/registry/llm_cost_ledger.jsonl"

# GROK_SENTIMENT_CACHE_TTL_MS: TTL des x_search-Screening-Caches (identische
# Symbole innerhalb des Fensters kosten nichts).
GROK_SENTIMENT_CACHE_TTL_MS="300000"

# ---------------------------------------------------------------
# MODUL 19 — ALPHA/SIGMA ORCHESTRATOR (app/orchestrator/alpha_sigma_engine.py)
# Harte Risiko-Kappen der SIGMA-Kammer. Änderungen wirken sofort (Prozess startet
# pro Aufruf neu), ein Neustart ist nicht nötig.
# ---------------------------------------------------------------
#ORS_ALPHA_MIN_SCORE=0.18
#ORS_ALPHA_MIN_AGREEMENT=0.35
#ORS_ALPHA_HALF_LIFE=12
#ORS_SIGMA_TARGET_VOL=0.20
#ORS_SIGMA_MAX_ALLOC_PCT=0.25
#ORS_SIGMA_MAX_RISK_PCT=0.02
#ORS_SIGMA_MAX_GROSS_EXPOSURE_PCT=0.60
#ORS_SIGMA_MAX_LEVERAGE=1.0
#ORS_SIGMA_EWMA_LAMBDA=0.94
#ORS_SIGMA_HARD_STOP_ATR=2.2
#ORS_SIGMA_TARGET_ATR=2.2
#ORS_SIGMA_COOLDOWN_BARS=1
#ORS_SIGMA_MOS_THRESHOLD=7.5
#ORS_SIGMA_HURST_TREND_GATE=0.55
#ORS_SIGMA_HURST_MEANREV_GATE=0.45
# Dispatch-Freigaben: ohne diese Flags stellt der Orchestrator nur Anträge zu.
#ORS_ALLOW_DISPATCH=0
#ORS_ALLOW_LIVE_DISPATCH=0

# ===========================================================================
# SIGMA × FABLE × JULES FUSION (paper-first)
# QUANT_BACKEND: sigma | legacy | off. sigma is default and fails closed if
# its adapter cannot be loaded; legacy is an explicit Runner fallback.
QUANT_BACKEND="sigma"
# Optional installed Sigma harvest module exposing evaluate(payload).
SIGMA_QUANT_MODULE=""
# Durable paper-intent journal consumed by Night-Train replay.
PAPER_LEDGER_FILE="data/paper/paper_intents.jsonl"
# Optional Academy event journal.
ACADEMY_EVENTS_FILE="data/academy/academy_events.jsonl"
# Never use an LLM or this adapter to authorize live orders.
AI_LIVE_ORDERS="false"
